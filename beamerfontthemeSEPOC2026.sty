\ProvidesPackage{beamerfontthemeSEPOC2026}[2026/10/08 SEPOC 2026 fonts]
\RequirePackage{fontspec}
\setsansfont{Roboto}[Scale=MatchLowercase]
\setmainfont{Roboto}[Scale=MatchLowercase]
\setbeamerfont{normal text}{family=\sffamily,size=\normalsize}
\setbeamerfont{frametitle}{family=\sffamily,series=\bfseries,size=\Large}
\setbeamerfont{title}{family=\sffamily,series=\bfseries,size=\LARGE}
\setbeamerfont{subtitle}{family=\sffamily,size=\large}
\setbeamerfont{author}{family=\sffamily,size=\large}
\setbeamerfont{institute}{family=\sffamily,size=\normalsize}
\setbeamerfont{date}{family=\sffamily,size=\normalsize}
\setbeamerfont{block title}{family=\sffamily,series=\bfseries}
