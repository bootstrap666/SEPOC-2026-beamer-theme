\ProvidesPackage{beamerthemeSEPOC2026}[2026/10/08 SEPOC 2026 Beamer theme]
\mode<presentation>{
  \RequirePackage{tikz}
  \RequirePackage{graphicx}
  \RequirePackage{etoolbox}
  \RequirePackage{beamercolorthemeSEPOC2026}
  \RequirePackage{beamerfontthemeSEPOC2026}

  \setbeamertemplate{navigation symbols}{}
  \setbeamertemplate{blocks}[rounded][shadow=false]
  \setbeamertemplate{itemize item}{\color{sepocorange}\small$\blacktriangleright$}
  \setbeamertemplate{itemize subitem}{\color{sepocorange}\scriptsize$\blacktriangleright$}
  \setbeamertemplate{enumerate item}{\color{sepocorange}\insertenumlabel.}

  % The original PowerPoint uses a 16:9 master with a fixed photographic header.
  \newcommand{\SEPOCHeader}{%
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=north west,inner sep=0pt] at (current page.north west) {%
        \includegraphics[width=\paperwidth,height=0.854in]{assets/image1-cropped.png}};
    \end{tikzpicture}%
  }

  \newcommand{\SEPOCFooter}{%
    \begin{tikzpicture}[remember picture,overlay]
      % The sponsor strip is centered on the physical center of the slide.
      % The frame number is a separate object and therefore cannot affect
      % the horizontal position of the sponsor strip.
      \node[anchor=south,inner sep=0pt] at ([yshift=0.035in]current page.south) {%
        \begin{tikzpicture}[baseline]
          \draw[sepocorange,line width=0.55pt] (0.00cm,0.02in) -- (0.00cm,0.34in);
          \node[anchor=south west,inner sep=0pt] at (0.28cm,0.035in) {\includegraphics[width=0.82cm]{assets/image2.png}};
          \draw[sepocorange,line width=0.55pt] (1.26cm,0.02in) -- (1.26cm,0.34in);
          \node[anchor=south west,inner sep=0pt] at (1.56cm,0.055in) {\includegraphics[width=4.25cm,height=0.25in,keepaspectratio]{assets/image3.png}};
          \node[anchor=south west,inner sep=0pt] at (3.61cm,0.035in) {\includegraphics[width=4.55cm,height=0.28in,keepaspectratio]{assets/image4.png}};
          \draw[sepocorange,line width=0.55pt] (8.66cm,0.02in) -- (8.66cm,0.34in);
          \node[anchor=south west,inner sep=0pt] at (8.95cm,0.055in) {\includegraphics[width=2.10cm,height=0.25in,keepaspectratio]{assets/image5.png}};
          \draw[sepocorange,line width=0.55pt] (11.25cm,0.02in) -- (11.25cm,0.34in);
        \end{tikzpicture}%
      };
      % Page number is deliberately independent of the centered sponsor strip.
      \ifnum\insertframenumber>1
        \node[anchor=south east,inner sep=0pt,font=\sffamily\small] at ([xshift=-0.48cm,yshift=0.07in]current page.south east) {\insertframenumber};
      \fi
    \end{tikzpicture}%
  }

  % Fixed header matching the PowerPoint master dimensions.
  % The source image has already been cropped according to the PPTX
  % srcRect, so it is safe to scale it to the full slide width.
  \setbeamertemplate{headline}{%
    \vbox to 0.854in{%
      \hbox to \paperwidth{%
        \includegraphics[width=\paperwidth,height=0.854in]{assets/image1-cropped.png}%
        \hss
      }%
      \vss
    }%
  }
  \setbeamertemplate{footline}{\vspace*{0.48in}\SEPOCFooter}

  \setbeamertemplate{frametitle}{%
    \vspace*{0.18in}%
    \hspace*{0.45in}%
    \insertframetitle\par
    \vspace*{0.06in}%
    \hspace*{0.45in}\color{sepocorange}\rule{0.55in}{1.3pt}%
    \vspace*{0.10in}%
  }

  % Keep the body clear of the fixed header/footer.
  \setbeamersize{text margin left=0.55in,text margin right=0.55in}
  \setlength{\headheight}{0.854in}
  \setlength{\footheight}{0.48in}
  \addtolength{\textheight}{-0.55in}

  \defbeamertemplate*{title page}{SEPOC2026}{%
    \vbox{}
    \vfill
    \begin{beamercolorbox}[wd=\textwidth,sep=0pt,center]{title}
      \usebeamerfont{title}\inserttitle\par
    \end{beamercolorbox}
    \vskip0.35em
    \begin{beamercolorbox}[wd=\textwidth,sep=0pt,center]{author}
      \usebeamerfont{author}\insertauthor\par
    \end{beamercolorbox}
    \vskip0.15em
    \begin{beamercolorbox}[wd=\textwidth,sep=0pt,center]{institute}
      \usebeamerfont{institute}\insertinstitute\par
    \end{beamercolorbox}
    \vfill
    \vskip0.2em
  }

  \AtBeginDocument{%
    \hypersetup{colorlinks=true,linkcolor=sepocorange,urlcolor=sepocorange,citecolor=sepocorange}%
  }
}
